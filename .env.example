# Environment Configuration for RAIL / SIGNAL

# Application
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=5173

# Database Connection (PostgreSQL)
# Adjust POSTGRES_PASSWORD and POSTGRES_PORT according to your local installation
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rail_signal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SQLAlchemy Database URI (Auto-constructed or explicit)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rail_signal

# File Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Ingestion & Quality Parameters
LOG_LEVEL=INFO
MAX_RECORD_AUDIT_LIMIT=1000
